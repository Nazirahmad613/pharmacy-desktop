{
  "name": "pharmacy-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.pharmacy.desktop",
    "productName": "Pharmacy Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!backend/**/*",
      "!php/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "php",
        "to": "php"
      }
    ]
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^5.3.1",
    "node-schedule": "^2.1.1"
  }
}
